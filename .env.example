# Bu dosyayi '.env' olarak kopyalayin ve kendi degerlerinizi girin.
# '.env' dosyasi .gitignore ile haric tutulur, repoya girmez.

# Anthropic (Claude) API anahtari — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Gmail SMTP ile rapor gonderimi
# NORMAL SIFRE DEGIL — Uygulama Sifresi kullanin:
# https://myaccount.google.com/apppasswords  (2 adimli dogrulama acik olmali)
GMAIL_ADDRESS=ornek@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Raporun gidecegi adres. Bos birakilirsa GMAIL_ADDRESS'e gonderilir.
RAPOR_ALICI=ornek@gmail.com
